{
  "name": "life-decision-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-content.mjs && vite build && tsx scripts/prerender.jsx",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "import:reference": "node scripts/import-reference.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name life-decision-guide --branch main"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "cheerio": "^1.1.2",
    "marked": "^18.0.14",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^8.3.2",
    "wrangler": "latest"
  }
}
